# ============================================
# DURIN ENGINE — Variables de entorno
# ============================================
# Copia este archivo como .env en backend/ y rellena los valores reales.
# NO commitees el archivo .env real.

# ----- BASE DE DATOS (Desarrollo Local) -----
# PostgreSQL corriendo en Docker (puerto 5433 para evitar conflicto con PG nativo)
DATABASE_URL="postgresql://durin_user:durin_password@localhost:5433/durin_engine?schema=public"

# ----- BACKEND -----
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# ----- DESPLIEGUE (Producción) -----
# Estos valores los usa scripts/deploy.ps1

# SSH / VPS Hetzner
DEPLOY_SSH_HOST=tu-vps-hetzner.com
DEPLOY_SSH_USER=deploy
DEPLOY_SSH_KEY_PATH=C:\Users\TuUsuario\.ssh\id_rsa

# Backend producción
PROD_DATABASE_URL=postgresql://durin_user:password@localhost:5432/durin_engine
PROD_FRONTEND_URL=https://durin-engine.pages.dev
PROD_API_URL=https://api.durin-engine.tudominio.com

# Cloudflare Pages
CLOUDFLARE_API_TOKEN=tu_token_de_cloudflare
CLOUDFLARE_ACCOUNT_ID=tu_account_id
CLOUDFLARE_PROJECT_NAME=durin-engine