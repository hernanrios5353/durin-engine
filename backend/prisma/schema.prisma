generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EquipmentType {
  CAMION
  EXCAVADORA
  PERFORADORA
}

enum MaintenanceType {
  PREVENTIVO
  CORRECTIVO
  PREDICTIVO
}

model Equipment {
  id                       String        @id @default(cuid())
  code                     String        @unique
  name                     String
  type                     EquipmentType
  currentHourmeter         Float         @default(0)
  lastMaintenanceHourmeter Float         @default(0)
  maintenanceInterval      Float
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  maintenance              Maintenance[]

  @@index([code])
  @@index([type])
}

model Maintenance {
  id               String          @id @default(cuid())
  equipmentId      String
  equipment        Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenanceType  MaintenanceType
  description      String
  hourmeter        Float
  maintenanceDate  DateTime        @default(now())
  observations     String?
  createdAt        DateTime        @default(now())

  @@index([equipmentId])
  @@index([maintenanceDate])
}

model MaintenanceTypeConfig {
  id        String        @id @default(cuid())
  type      EquipmentType @unique
  interval  Float
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}